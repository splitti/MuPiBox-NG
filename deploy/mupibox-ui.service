[Unit]
Description=MuPiBox-NG native Qt Quick touchscreen UI
After=local-fs.target systemd-user-sessions.service mupibox-splash.service
Wants=mupibox-ng.service mupibox-splash.service
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=mupibox
Group=mupibox
WorkingDirectory=/usr/local/share/mupibox-ng/ui
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_IM_MODULE=qtvirtualkeyboard
ExecStart=/usr/lib/qt6/bin/qmlscene /usr/local/share/mupibox-ng/ui/Main.qml
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
