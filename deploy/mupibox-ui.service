[Unit]
Description=MuPiBox-NG native Qt Quick touchscreen UI
After=local-fs.target systemd-user-sessions.service
Wants=mupibox-ng.service
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=mupibox
Group=mupibox
WorkingDirectory=/usr/local/share/mupibox-ng/ui
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
ExecStart=/usr/lib/qt6/bin/qmlscene /usr/local/share/mupibox-ng/ui/Main.qml
Restart=always
RestartSec=2
TTYPath=/dev/tty1
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
