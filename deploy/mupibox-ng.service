[Unit]
Description=MuPiBox-NG music player
After=network.target sound.target mupibox-system-agent.service
Wants=mupibox-system-agent.service

[Service]
Type=simple
User=mupibox
Group=mupibox
SupplementaryGroups=audio netdev
ExecStart=/usr/local/lib/mupibox-ng/mupibox -config /etc/mupibox-ng/config.json
WorkingDirectory=/var/lib/mupibox-ng
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=mupibox-ng
UMask=0077
NoNewPrivileges=true
# wpa_cli creates its reply socket below /tmp. wpa_supplicant runs outside
# this unit and must be able to resolve that socket path to return scan data.
PrivateTmp=false
ProtectSystem=strict
# wpa_cli places its client socket below /tmp. ProtectSystem=strict would make
# the shared directory read-only unless this narrow write exception is present.
ReadWritePaths=/tmp /srv/mupibox/music
ProtectHome=true
RestrictSUIDSGID=true
# Hands this unit's own cgroup v2 subtree to the service (no root needed):
# internal/tts creates a "tts" child cgroup there and caps cpu.max per Piper
# render job (see internal/tts/cpulimit.go), so one long synthesis job can
# never starve mpv/the UI for CPU. Orthogonal to the sandboxing above --
# systemd keeps the delegated subtree writable even under ProtectSystem, and
# it does not relax NoNewPrivileges/ProtectSystem/RestrictSUIDSGID. Where
# cgroup v2 delegation is unavailable (older DietPi image, hybrid/cgroup v1
# host), internal/tts falls back to lowering the Piper process's scheduling
# priority instead -- no config change is required here for that path.
Delegate=yes

[Install]
WantedBy=multi-user.target
