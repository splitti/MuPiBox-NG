[Unit]
Description=MuPiBox-NG music player
After=network.target sound.target

[Service]
Type=simple
User=mupibox
Group=mupibox
SupplementaryGroups=audio
ExecStart=/usr/local/lib/mupibox-ng/mupibox -config /etc/mupibox-ng/config.json
WorkingDirectory=/var/lib/mupibox-ng
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=mupibox-ng
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
